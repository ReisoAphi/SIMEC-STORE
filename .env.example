# --- Servidor ---
PORT=4100
NODE_ENV=development
BASE_URL=https://simecautomation.com
STORE_MOUNT=/tienda

# --- Sesiones (genera una cadena aleatoria larga: `openssl rand -hex 48`) ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
SUPER_ADMIN_EMAIL=admin@simecautomation.com

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simec_store
DB_USER=simec_store_user
DB_PASSWORD=

# --- Correo SMTP ---
SMTP_HOST=mail.simecautomation.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@simecautomation.com
SMTP_PASS=
MAIL_FROM="SIMEC Tienda <noreply@simecautomation.com>"
MAIL_SALES_INBOX=ventas@simecautomation.com

# --- Skydropx (envíos multi-carrier) ---
# https://sandbox.skydropx.com  |  https://api.skydropx.com
SKYDROPX_BASE_URL=https://api.skydropx.com/v1
SKYDROPX_API_KEY=
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=

# --- Mercado Pago (Checkout Pro) ---
# Obtén tus credenciales en https://www.mercadopago.com.mx/developers
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Facturama (CFDI 4.0) ---
FACTURAMA_BASE_URL=https://api.facturama.mx
FACTURAMA_USER=
FACTURAMA_PASS=
EMISOR_RFC=
EMISOR_REGIMEN_FISCAL=601
EMISOR_LUGAR_EXPEDICION=

# --- Almacén origen (para cotizador de envío) ---
ORIGEN_CP=66600
ORIGEN_ESTADO=Nuevo León
ORIGEN_CIUDAD=Apodaca
